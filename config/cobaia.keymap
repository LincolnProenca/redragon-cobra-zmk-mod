#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/rgb.h>

#define GAMING 0
#define DPI_SLOW 1
#define DPI_FAST 2
#define OFFICE 3

/ {
    behaviors {
    scroll_encoder: scroll_encoder {
        compatible = "zmk,behavior-sensor-rotate-var";
        #sensor-binding-cells = <2>;
        bindings = <&msc>, <&msc>;
        tap-ms = <40>;
    };

    td_boot: tap_dance_boot {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <250>;
            bindings = <&none>, <&bootloader>;
        };
    };

    combos {
        compatible = "zmk,combos";

        combo_rgb_toggle {
            timeout-ms = <50>;
            key-positions = <0 2>; 
            bindings = <&rgb_ug RGB_TOG>;
        };

        combo_rgb_effect {
            timeout-ms = <50>;
            key-positions = <1 2>; 
            bindings = <&rgb_ug RGB_EFF>;
        };
    };

    macros {
        macro_align_center: macro_align_center {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <50>;
            tap-ms = <30>;
            bindings = <&kp LC(DOT)>, <&kp C>, <&kp E>, <&kp N>, <&kp T>, <&kp E>, <&kp R>, <&kp RET>;
        };

        macro_dist_vert: macro_dist_vert {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <50>;
            tap-ms = <30>;
            bindings = <&kp LC(DOT)>, <&kp V>, <&kp E>, <&kp R>, <&kp T>, <&kp I>, <&kp C>, <&kp A>, <&kp L>, <&kp L>, <&kp Y>, <&kp RET>;
        };

        macro_dpi_cycle: macro_dpi_cycle {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&tog DPI_SLOW>, <&tog DPI_FAST>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        gaming_layer {
            bindings = <
                &mkp LCLK          // 0: Left Click
                &mkp RCLK          // 1: Right Click
                &mkp MCLK          // 2: Middle Click
                &mkp MB5           // 3: Side 1 (Back)
                &mkp MB4           // 4: Side 2 (Forward)
                &tog DPI_SLOW      // 5: DPI cycle enabled for Gaming
                &tog OFFICE        // 6: Top 2 (Toggle Layer)
                &bt BT_NXT         // 7: Top 3 (Switch PC)
                &td_boot           // 8: Bottom (Double click for Bootloader)
            >;
            sensor-bindings = <&scroll_encoder MOVE_Y(-40) MOVE_Y(40)>;
        };

        dpi_slow_layer {
            bindings = <
                &trans
                &trans
                &trans
                &trans
                &trans
                &macro_dpi_cycle   
                &trans
                &trans
                &trans
            >;
            sensor-bindings = <&scroll_encoder MOVE_Y(-40) MOVE_Y(40)>;
        };

        dpi_fast_layer {
            bindings = <
                &trans
                &trans
                &trans
                &trans
                &trans
                &tog DPI_FAST      
                &trans
                &trans
                &trans
            >;
            sensor-bindings = <&scroll_encoder MOVE_Y(-40) MOVE_Y(40)>;
        };

        office_layer {
            bindings = <
                &mkp LCLK          
                &mkp RCLK          
                &mkp MCLK          
                &macro_align_center
                &macro_dist_vert   
                &kp LC(D)          
                &tog OFFICE        
                &bt BT_NXT         
                &td_boot
            >;
            sensor-bindings = <&scroll_encoder MOVE_Y(-40) MOVE_Y(40)>;
        };

    };
};